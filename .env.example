# ── ENV ───────────────────────────────────────────────────────────
ENV=local                      # production'da: production
DEBUG=false

# ── DATABASE / JWT / DOCS ─────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./enwis.db
JWT_SECRET=                    # kamida 32 belgi, tasodifiy
ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
DOCS_USERNAME=enwis
DOCS_PASSWORD=
INTERNAL_API_TOKEN=            # production'da kamida 32 belgi

# ── GOOGLE ────────────────────────────────────────────────────────
# test.enwis.uz frontend ishlatayotgan OAuth *Web* Client ID bilan AYNAN bir xil bo'lishi shart.
# Bir nechta (web + mobil) bo'lsa vergul bilan: id1.apps.googleusercontent.com,id2.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# ── TELEGRAM ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=            # @BotFather -> bot token
TELEGRAM_BOT_USERNAME=enwis_bot
# @BotFather -> Bot Settings -> Login Widget. Client ID bo'sh qolsa — bot token'idagi bot ID olinadi.
TELEGRAM_CLIENT_ID=
# Faqat redirect (code) oqimi uchun kerak; JS kutubxonasi (id_token) oqimida shart emas.
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REQUIRE_NONCE=false   # true: frontend /auth/telegram/nonce'dan olingan nonce'ni majburan ishlatadi
TELEGRAM_AUTH_MAX_AGE=86400

# ── CORS / FRONTEND / COOKIES ─────────────────────────────────────
ALLOWED_ORIGINS=["https://enwis.uz","https://app.enwis.uz","https://test.enwis.uz","https://exams.enwis.uz"]
FRONTEND_URL=https://test.enwis.uz
COOKIE_DOMAIN=.enwis.uz        # api.enwis.uz <-> test.enwis.uz o'rtasida cookie ishlashi uchun
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# ── SMS (eskiz.uz) — o'zgarmagan ──────────────────────────────────
SMS_GATEWAY_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_FROM=4546
